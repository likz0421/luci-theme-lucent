#!/bin/sh
# Lucent 3 helper: media library, online wallpapers and allow-listed packages.
# The browser never supplies a shell command or an arbitrary path.

. /usr/share/libubox/jshn.sh

ROOT="/www/luci-static/lucent/media"
URL="/luci-static/lucent/media"
TMPDIR="/tmp/lucent-upload"
TMP="$TMPDIR/file.bin"
RUN="/var/run"
LOG="$RUN/lucent-install.log"
CODE="$RUN/lucent-install.code"
PID="$RUN/lucent-install.pid"
IJOB="$RUN/lucent-install.job.sh"
UPLOG="$RUN/lucent-update.log"
UPCODE="$RUN/lucent-update.code"
UPPID="$RUN/lucent-update.pid"
UPJOB="$RUN/lucent-update.job.sh"
CHECKCACHE="/tmp/lucent-check.json"
CHECKPID="$RUN/lucent-check.pid"
CHECKJOB="$RUN/lucent-check.job.sh"
INSTALLER="/usr/share/lucent/install.sh"

# Is the lock really held by our own job? `kill -0` alone is not enough: PIDs
# get reused, so a job that finished without anyone polling its status leaves a
# pid file whose number later belongs to some unrelated live process — and then
# the UI reports "An update is already running" forever, with no way out from
# inside the page. When the process is ours, /proc/<pid>/cmdline names the job
# script; when it is not, the lock is stale and gets dropped.
job_alive() {
	local pid cmd
	pid=$(cat "$1" 2>/dev/null)
	[ -n "$pid" ] || return 1
	kill -0 "$pid" 2>/dev/null || return 1
	if [ -r "/proc/$pid/cmdline" ]; then
		cmd=$(tr '\000' ' ' < "/proc/$pid/cmdline" 2>/dev/null)
		if [ -n "$cmd" ]; then
			case "$cmd" in
				*"$2"*) return 0 ;;
				*) return 1 ;;
			esac
		fi
	fi
	return 0
}

mkdir -p "$TMPDIR" 2>/dev/null || true

err() {
	json_init
	json_add_int ok 0
	json_add_string error "$1"
	json_dump
	json_cleanup
	exit 0
}

ok() {
	json_init
	json_add_int ok 1
	json_dump
	json_cleanup
	exit 0
}

magic() {
	local hex
	if command -v hexdump >/dev/null 2>&1; then
		hex=$(hexdump -v -n 12 -e '1/1 "%02x"' "$1" 2>/dev/null)
	elif command -v od >/dev/null 2>&1; then
		hex=$(od -An -tx1 -N12 "$1" 2>/dev/null | tr -d ' \n')
	else
		return 1
	fi
	case "$hex" in
		ffd8ff*) echo jpg ;;
		89504e470d0a1a0a*) echo png ;;
		47494638*) echo gif ;;
		52494646????????57454250) echo webp ;;
		00000100*) echo ico ;;
		????????66747970) echo mp4 ;;
		????????66747970*) echo mp4 ;;
		1a45dfa3*) echo webm ;;
	esac
}

download() {
	local url="$1" out="$2"
	rm -f "$out"
	# URLs come back from remote APIs; a value starting with "-" would be eaten
	# as a wget option and could write anywhere as root.
	case "$url" in http://*|https://*) ;; *) return 1 ;; esac
	if command -v uclient-fetch >/dev/null 2>&1; then
		uclient-fetch -q -T 30 -O "$out" "$url" >/dev/null 2>&1
	elif command -v wget >/dev/null 2>&1; then
		wget -q -T 30 -O "$out" "$url" >/dev/null 2>&1
	else
		return 1
	fi
	[ -s "$out" ]
}

safe_name() {
	printf '%s' "$1" | sed 's/\.[^.]*$//; s/[^A-Za-z0-9._-]/-/g; s/^-*//; s/-*$//' | cut -c1-48
}

media_url() {
	echo "$URL/$1/$2"
}

# ------------------------------------------------------------------ methods
media_list() {
	local kind f name size
	json_init
	json_add_array "items"
	for kind in image video icon wallpaper; do
		[ -d "$ROOT/$kind" ] || continue
		for f in "$ROOT/$kind"/*; do
			[ -f "$f" ] && [ ! -L "$f" ] || continue
			name=${f##*/}
			case "$name" in .*) continue ;; esac
			size=$(wc -c < "$f" 2>/dev/null)
			json_add_object
			json_add_string kind "$kind"
			json_add_string name "$name"
			json_add_string url "$(media_url "$kind" "$name")"
			json_add_int size "${size:-0}"
			json_close_object
		done
	done
	json_close_array
	json_dump
	json_cleanup
}

media_commit() {
	local kind name size max ext base out n
	read -r input
	json_load "$input"
	json_get_var kind kind
	json_get_var name name
	json_cleanup

	case "$kind" in image|video|icon) ;; *) err "Unknown media type" ;; esac
	[ -f "$TMP" ] && [ ! -L "$TMP" ] || err "Upload not found"

	size=$(wc -c < "$TMP" 2>/dev/null)
	size=${size:-0}
	[ "$size" -gt 0 ] || err "The file is empty"

	case "$kind" in
		image) max=8388608 ;;
		video) max=33554432 ;;
		icon) max=1048576 ;;
	esac
	[ "$size" -le "$max" ] || err "The file is larger than the limit"

	ext=$(magic "$TMP")
	[ -n "$ext" ] || err "Unsupported file format"
	case "$kind:$ext" in
		image:jpg|image:png|image:gif|image:webp|video:mp4|video:webm|icon:png|icon:webp|icon:ico) ;;
		*) err "This format is not allowed for this type" ;;
	esac

	base=$(safe_name "$name")
	[ -n "$base" ] || base="$kind"
	mkdir -p "$ROOT/$kind" || err "Cannot create the media directory"
	chmod 755 "$ROOT" "$ROOT/$kind" 2>/dev/null
	out="$ROOT/$kind/${base}-$(date +%s).$ext"
	n=1
	while [ -e "$out" ]; do
		out="$ROOT/$kind/${base}-$(date +%s)-$n.$ext"
		n=$((n + 1))
	done

	mv -f "$TMP" "$out" || err "Cannot save the upload"
	chmod 644 "$out" 2>/dev/null
	chown root:root "$out" 2>/dev/null

	json_init
	json_add_int ok 1
	json_add_string kind "$kind"
	json_add_string name "${out##*/}"
	json_add_string url "$(media_url "$kind" "${out##*/}")"
	json_add_int size "$size"
	json_dump
	json_cleanup
}

media_remove() {
	local kind name f
	read -r input
	json_load "$input"
	json_get_var kind kind
	json_get_var name name
	json_cleanup

	case "$kind" in image|video|icon|wallpaper) ;; *) err "Unknown media type" ;; esac
	case "$name" in ''|.*|*/*|*\\*) err "Invalid file name" ;; esac
	f="$ROOT/$kind/$name"
	[ -f "$f" ] && [ ! -L "$f" ] || err "File not found"
	rm -f "$f" || err "Cannot remove the file"
	ok
}

wallpaper_fetch() {
	local provider query key tmp url file ext base out n
	read -r input
	json_load "$input"
	json_get_var provider provider
	json_get_var query query
	json_get_var key key
	json_cleanup

	case "$provider" in bing|unsplash|wallhaven) ;; *) err "Unknown wallpaper source" ;; esac
	case "$key" in *[!A-Za-z0-9_-]*) err "Invalid API key" ;; esac
	query=$(printf '%s' "$query" | tr -cd 'A-Za-z0-9 _-' | cut -c1-60)
	query=$(printf '%s' "$query" | sed 's/ /%20/g')

	tmp="/tmp/lucent-wallpaper.json"
	case "$provider" in
		bing)
			url="https://www.bing.com/HPImageArchive.aspx?format=js&idx=0&n=1&mkt=zh-CN"
			download "$url" "$tmp" || err "Cannot reach Bing"
			url=$(jsonfilter -i "$tmp" -e '@.images[0].url' 2>/dev/null)
			[ -n "$url" ] || err "Bing returned no image"
			case "$url" in http*) ;; *) url="https://www.bing.com$url" ;; esac
			;;
		unsplash)
			[ -n "$key" ] || err "Unsplash needs an API key"
			url="https://api.unsplash.com/photos/random?orientation=landscape&client_id=$key"
			[ -n "$query" ] && url="$url&query=$query"
			download "$url" "$tmp" || err "Cannot reach Unsplash"
			url=$(jsonfilter -i "$tmp" -e '@.urls.full' 2>/dev/null)
			[ -n "$url" ] || err "Unsplash returned no image"
			;;
		wallhaven)
			url="https://wallhaven.cc/api/v1/search?sorting=random&atleast=1920x1080&categories=111&purity=100"
			[ -n "$query" ] && url="$url&q=$query"
			download "$url" "$tmp" || err "Cannot reach Wallhaven"
			url=$(jsonfilter -i "$tmp" -e '@.data[0].path' 2>/dev/null)
			[ -n "$url" ] || err "Wallhaven returned no image"
			;;
	esac

	file="/tmp/lucent-wallpaper.img"
	download "$url" "$file" || err "Cannot download the image"
	ext=$(magic "$file")
	case "$ext" in jpg|png|webp) ;; *) rm -f "$file"; err "The source did not return an image" ;; esac

	mkdir -p "$ROOT/wallpaper" || err "Cannot create the wallpaper directory"
	chmod 755 "$ROOT" "$ROOT/wallpaper" 2>/dev/null
	base=$(safe_name "$provider")
	out="$ROOT/wallpaper/${base}-$(date +%s).$ext"
	n=1
	while [ -e "$out" ]; do
		out="$ROOT/wallpaper/${base}-$(date +%s)-$n.$ext"
		n=$((n + 1))
	done
	mv -f "$file" "$out" || err "Cannot save the wallpaper"
	chmod 644 "$out" 2>/dev/null

	json_init
	json_add_int ok 1
	json_add_string name "${out##*/}"
	json_add_string url "$(media_url wallpaper "${out##*/}")"
	json_dump
	json_cleanup
}

plugin_installed() {
	local pkg="$1"
	if command -v apk >/dev/null 2>&1; then
		apk info -e "$pkg" >/dev/null 2>&1
	elif command -v opkg >/dev/null 2>&1; then
		opkg list-installed 2>/dev/null | grep -q "^$pkg "
	else
		return 1
	fi
}

installed_set() {
	if command -v apk >/dev/null 2>&1; then
		apk info 2>/dev/null
	elif command -v opkg >/dev/null 2>&1; then
		opkg list-installed 2>/dev/null | cut -d' ' -f1
	fi
}

plugin_check() {
	local name pkg list
	# One package-database read, not eight: each extra opkg/adb scan here cost
	# a second of the rpcd worker and stalled the whole settings page.
	list=$(installed_set)
	json_init
	json_add_array "items"
	for name in openclash passwall passwall2 ssrplus mosdns adguardhome dockerman smartdns; do
		case "$name" in
			openclash) pkg="luci-app-openclash" ;;
			passwall) pkg="luci-app-passwall" ;;
			passwall2) pkg="luci-app-passwall2" ;;
			ssrplus) pkg="luci-app-ssr-plus" ;;
			mosdns) pkg="luci-app-mosdns" ;;
			adguardhome) pkg="luci-app-adguardhome" ;;
			dockerman) pkg="luci-app-dockerman" ;;
			smartdns) pkg="luci-app-smartdns" ;;
		esac
		json_add_object
		json_add_string name "$name"
		json_add_string pkg "$pkg"
		json_add_int installed "$(printf '%s\n' "$list" | grep -qx "$pkg" && echo 1 || echo 0)"
		json_close_object
	done
	json_close_array
	json_dump
	json_cleanup
}

plugin_install() {
	local name pkg job
	read -r input
	json_load "$input"
	json_get_var name name
	json_cleanup

	case "$name" in
		openclash) pkg="luci-app-openclash" ;;
		passwall) pkg="luci-app-passwall" ;;
		passwall2) pkg="luci-app-passwall2" ;;
		ssrplus) pkg="luci-app-ssr-plus" ;;
		mosdns) pkg="luci-app-mosdns" ;;
		adguardhome) pkg="luci-app-adguardhome" ;;
		dockerman) pkg="luci-app-dockerman" ;;
		smartdns) pkg="luci-app-smartdns" ;;
		*) err "This package is not allow-listed" ;;
	esac

	if plugin_installed "$pkg"; then
		json_init
		json_add_int ok 1
		json_add_int installed 1
		json_add_string message "Already installed"
		json_dump
		json_cleanup
		exit 0
	fi

	job_alive "$PID" "$IJOB" && \
		err "Another installation is still running"

	rm -f "$CODE" "$LOG" "$PID"
	if command -v apk >/dev/null 2>&1; then
		cat > "$IJOB" <<EOF
#!/bin/sh
apk add '$pkg' >'$LOG' 2>&1
echo \$? >'$CODE'
rm -f '$PID'
EOF
	else
		cat > "$IJOB" <<EOF
#!/bin/sh
opkg update >'$LOG' 2>&1
opkg install '$pkg' >>'$LOG' 2>&1
echo \$? >'$CODE'
rm -f '$PID'
EOF
	fi
	chmod 755 "$IJOB"

	if command -v start-stop-daemon >/dev/null 2>&1; then
		start-stop-daemon -S -b -m -p "$PID" -x /bin/sh -- "$IJOB"
	else
		setsid sh "$IJOB" </dev/null >/dev/null 2>&1 &
	fi

	json_init
	json_add_int ok 1
	json_add_int started 1
	json_add_string pkg "$pkg"
	json_dump
	json_cleanup
}

plugin_status() {
	local pid code running=0
	pid=$(cat "$PID" 2>/dev/null)
	code=$(cat "$CODE" 2>/dev/null)
	job_alive "$PID" "$IJOB" && running=1
	[ "$running" = 0 ] && rm -f "$PID"

	json_init
	json_add_int running "$running"
	if [ -n "$code" ]; then
		json_add_int code "$code"
	else
		json_add_int code -1
	fi
	json_add_string log "$(tail -c 1200 "$LOG" 2>/dev/null)"
	json_dump
	json_cleanup
}

wallpaper_auto() {
	local enabled mark line
	read -r input
	json_load "$input"
	json_get_var enabled enabled
	json_cleanup

	case "$enabled" in
		1)
			mkdir -p /etc/crontabs
			mark="# lucent-wallpaper"
			line="0 6 * * * /bin/sh /usr/share/lucent/wallpaper.sh $mark"
			grep -qF "$mark" /etc/crontabs/root 2>/dev/null || printf '%s\n' "$line" >> /etc/crontabs/root
			chmod 600 /etc/crontabs/root 2>/dev/null
			uci -q set lucent.main.wallpaper_auto=1
			;;
		0)
			sed -i "/# lucent-wallpaper/d" /etc/crontabs/root 2>/dev/null
			uci -q set lucent.main.wallpaper_auto=0
			;;
		*) err "Invalid argument" ;;
	esac
	uci -q commit lucent
	/etc/init.d/cron restart >/dev/null 2>&1 || true
	ok
}

# Count upgradable system packages, cached and detached like theme_check.
PKGUPCACHE="/tmp/lucent-pkgupdates.json"
PKGUPPID="$RUN/lucent-pkgupdates.pid"
PKGUPJOB="$RUN/lucent-pkgupdates.job.sh"

pkg_updates() {
	local now ts body
	now=$(date +%s 2>/dev/null); case "$now" in ''|*[!0-9]*) now=0 ;; esac
	if [ -f "$PKGUPCACHE" ]; then
		ts=$(sed -n '1p' "$PKGUPCACHE" 2>/dev/null)
		body=$(sed -n '2p' "$PKGUPCACHE" 2>/dev/null)
		case "$ts" in ''|*[!0-9]*) ts=0 ;; esac
		case "$body" in
			'{'*) [ $(( now - ts )) -ge 0 ] && [ $(( now - ts )) -lt 3600 ] && { printf '%s\n' "$body"; exit 0; } ;;
		esac
	fi

	if job_alive "$PKGUPPID" "$PKGUPJOB"; then
		json_init
		json_add_int checking 1
		json_dump
		json_cleanup
		exit 0
	fi

	rm -f "$PKGUPPID"
	cat > "$PKGUPJOB" <<EOF
#!/bin/sh
if command -v apk >/dev/null 2>&1; then
	apk update >/dev/null 2>&1
	n=\$(apk list --upgradable 2>/dev/null | grep -c '^')
else
	opkg update >/dev/null 2>&1
	n=\$(opkg list-upgradable 2>/dev/null | grep -c ' - ')
fi
case "\$n" in ''|*[!0-9]*) n=-1 ;; esac
{ printf '%s\\n' "\$(date +%s)"; printf '{"count":%d}\\n' "\$n"; } >'$PKGUPCACHE.tmp' && mv -f '$PKGUPCACHE.tmp' '$PKGUPCACHE'
rm -f '$PKGUPPID'
EOF
	chmod 755 "$PKGUPJOB"

	if command -v start-stop-daemon >/dev/null 2>&1; then
		start-stop-daemon -S -b -m -p "$PKGUPPID" -x /bin/sh -- "$PKGUPJOB"
	else
		setsid sh "$PKGUPJOB" </dev/null >/dev/null 2>&1 &
	fi

	json_init
	json_add_int checking 1
	json_dump
	json_cleanup
}

storage() {
	local mp size avail
	json_init
	for mp in / /overlay; do
		size=$(df -kP "$mp" 2>/dev/null | awk 'NR==2{print $2}')
		avail=$(df -kP "$mp" 2>/dev/null | awk 'NR==2{print $4}')
		[ -n "$size" ] || continue
		json_add_object "$mp"
		json_add_int total "$(( size * 1024 ))"
		json_add_int free "$(( avail * 1024 ))"
		json_close_object
	done
	json_dump
	json_cleanup
}

theme_current() {
	local v=""
	if command -v apk >/dev/null 2>&1; then
		v=$(apk info -e -v luci-theme-lucent 2>/dev/null | head -n1 | sed 's/^luci-theme-lucent-//')
	elif command -v opkg >/dev/null 2>&1; then
		v=$(opkg status luci-theme-lucent 2>/dev/null | sed -n 's/^Version: //p' | head -n1)
	fi
	[ -n "$v" ] || v=$(cat /usr/share/lucent/version 2>/dev/null)
	printf '%s' "$v"
}

# ------------------------------------------------------------------ overview
overview() {
	local ver cores l1 l5 l15 pids running total ct ctmax v best f
	ver=$(theme_current)
	cores=$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)
	case "$cores" in ''|*[!0-9]*) cores=0 ;; esac
	pids=""
	[ -r /proc/loadavg ] && read -r l1 l5 l15 pids _x < /proc/loadavg
	running=""; total=""
	case "$pids" in
		*/*) running="${pids%%/*}"; total="${pids##*/}" ;;
	esac
	ct=$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null)
	ctmax=$(cat /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null)

	best=""
	for f in /sys/class/thermal/thermal_zone*/temp; do
		[ -f "$f" ] || continue
		v=$(cat "$f" 2>/dev/null)
		case "$v" in ''|*[!0-9]*) continue ;; esac
		# Some SoCs report millidegrees here (46000), others degrees (46).
		[ "$v" -ge 1000 ] && v=$((v / 1000))
		[ "$v" -gt 0 ] && [ "$v" -lt 120 ] || continue
		{ [ -z "$best" ] || [ "$v" -lt "$best" ]; } && best=$v
	done
	if [ -z "$best" ]; then
		for f in /sys/class/hwmon/hwmon*/temp*_input; do
			[ -f "$f" ] || continue
			v=$(cat "$f" 2>/dev/null)
			case "$v" in ''|*[!0-9]*) continue ;; esac
			[ "$v" -ge 1000 ] && [ "$v" -le 120000 ] || continue
			v=$((v / 1000))
			{ [ -z "$best" ] || [ "$v" -lt "$best" ]; } && best=$v
		done
	fi

	# Per-core busy percent from /proc/stat deltas between polls.
	local prev cur cpubars
	cpubars=""
	prev=$(cat /tmp/lucent-cpu.prev 2>/dev/null)
	cur=$(awk '/^cpu[0-9]/{t=0;idle=$5+$6;for(n=2;n<=NF;n++)t+=$n;printf "%d %d\n", t, idle}' /proc/stat 2>/dev/null)
	if [ -n "$prev" ] && [ -n "$cur" ]; then
		cpubars=$(printf '%s\n' "$prev" | awk -v cur="$cur" '
			BEGIN { n = split(cur, C, "\n") }
			{ P[FNR] = $0 }
			END {
				for (i = 1; i <= n && i <= FNR; i++) {
					split(P[i], a, " "); split(C[i], b, " ")
					dt = b[1] - a[1]; di = b[2] - a[2]
					if (dt > 0) { x = int((dt - di) * 100 / dt); if (x < 0) x = 0; if (x > 100) x = 100; printf "%d\n", x }
				}
			}')
	fi
	[ -n "$cur" ] && printf '%s\n' "$cur" > /tmp/lucent-cpu.prev

	json_init
	json_add_string version "$ver"
	json_add_int cores "$cores"
	if [ -n "$cpubars" ]; then
		json_add_array cpus
		for v in $cpubars; do json_add_int "" "$v"; done
		json_close_array
	fi
	[ -n "$l1" ] && json_add_string load1 "$l1"
	[ -n "$l5" ] && json_add_string load5 "$l5"
	[ -n "$l15" ] && json_add_string load15 "$l15"
	[ -n "$running" ] && json_add_int processes_running "$running"
	[ -n "$total" ] && json_add_int processes_total "$total"
	[ -n "$ct" ] && json_add_int conntrack "$ct"
	[ -n "$ctmax" ] && json_add_int conntrack_max "$ctmax"
	[ -n "$best" ] && json_add_int temp_c "$best"
	json_dump
	json_cleanup
}

# ------------------------------------------------------- per-host traffic
# Realtime per-device rates without a daemon or firewall rules: conntrack can
# account bytes per flow (nf_conntrack_acct), so summing the two tuples of each
# entry per inner IP and diffing against the previous snapshot gives down/up
# rate, flow count and how long a host has been silent.
HOSTCUR="/tmp/lucent-host.cur"
HOSTPREV="/tmp/lucent-host.prev"

lan_prefixes() {
	local ip mask bits o1 o2 o3 rest
	ip=$(uci -q get network.lan.ipaddr 2>/dev/null)
	mask=$(uci -q get network.lan.netmask 2>/dev/null)
	# Anything but a dotted-quad would make the awk pattern match nothing, or
	# worse, everything.
	case "$ip" in
		*[0-9]*.[0-9]*.[0-9]*.[0-9]*) ;;
		*) return 0 ;;
	esac
	case "$ip" in
		*[!0-9.]*) return 0 ;;
	esac
	bits=24
	case "$mask" in
		255.255.255.255) bits=32 ;;
		255.255.255.0) bits=24 ;;
		255.255.0.0) bits=16 ;;
		255.0.0.0) bits=8 ;;
	esac
	o1=${ip%%.*}
	rest=${ip#*.}
	o2=${rest%%.*}
	rest=${rest#*.}
	o3=${rest%%.*}
	case "$bits" in
		8) echo "$o1." ;;
		16) echo "$o1.$o2." ;;
		*) echo "$o1.$o2.$o3." ;;
	esac
}

host_rates() {
	local want cur now total pfx lanpfx
	want=$(uci -q get lucent.main.acct 2>/dev/null)
	cur=$(cat /proc/sys/net/netfilter/nf_conntrack_acct 2>/dev/null)

	if [ "$want" = "1" ] && [ "$cur" != "1" ]; then
		echo 1 > /proc/sys/net/netfilter/nf_conntrack_acct 2>/dev/null || true
		cur=$(cat /proc/sys/net/netfilter/nf_conntrack_acct 2>/dev/null)
	fi

	now=$(date +%s 2>/dev/null); case "$now" in ''|*[!0-9]*) now=0 ;; esac

	json_init
	json_add_int wanted "$([ "$want" = "1" ] && echo 1 || echo 0)"

	if [ "$cur" != "1" ] || [ ! -r /proc/net/nf_conntrack ]; then
		json_add_int enabled 0
		json_dump
		json_cleanup
		return
	fi
	json_add_int enabled 1

	# RFC1918 plus the actual LAN subnet counts as "inner". [.] keeps the
	# pattern free of backslashes, which awk -v would otherwise unescape.
	# An empty alternative would match every address, so only add the LAN
	# prefix when the router actually reports one.
	lanpfx=$(lan_prefixes | sed 's/[.]/[.]/g')
	pfx="^(10[.]|192[.]168[.]|172[.](1[6-9]|2[0-9]|3[01])[.]"
	[ -n "$lanpfx" ] && pfx="$pfx|$lanpfx"
	pfx="$pfx)"

	awk -v P="$pfx" '
		{
			ns=0; nd=0; nb=0; s1=""; d1=""; s2=""; d2=""; b1=-1; b2=-1
			for (i = 1; i <= NF; i++) {
				t = $i
				if (t ~ /^src=/)  { ns++; v = substr(t, 5); if (ns == 1) s1 = v; else if (ns == 2) s2 = v }
				else if (t ~ /^dst=/) { nd++; v = substr(t, 5); if (nd == 1) d1 = v; else if (nd == 2) d2 = v }
				else if (t ~ /^bytes=/) { nb++; v = substr(t, 7) + 0; if (nb == 1) b1 = v; else if (nb == 2) b2 = v }
			}
			if (s1 == "" || b1 < 0) next
			if (s1 ~ P)      { h = s1; rx = (b2 < 0 ? 0 : b2); tx = b1 }
			else if (d1 ~ P) { h = d1; rx = b1; tx = (b2 < 0 ? 0 : b2) }
			else next
			RX[h] += rx; TX[h] += tx; FL[h]++
		}
		END { for (h in RX) printf "%s %d %d %d\n", h, RX[h], TX[h], FL[h] }
	' /proc/net/nf_conntrack > "$HOSTCUR" 2>/dev/null

	total=$(wc -l < "$HOSTCUR" 2>/dev/null); total=${total:-0}

	json_add_int hosts "$total"
	json_add_int seconds "$now"
	json_add_object "rates"

	if [ "$total" -gt 0 ]; then
		# prev rows are "host rx tx last-seen"; the same pass writes the next
		# snapshot, so the baseline always carries a real timestamp
		awk -v now="$now" -v prev="$HOSTPREV" -v snap="$HOSTPREV.new" '
			BEGIN {
				t0 = 0
				if ((getline line < prev) > 0) {
					split(line, p, " "); t0 = p[2] + 0
					while ((getline line < prev) > 0) {
						split(line, a, " ")
						pr[a[1]] = a[2] + 0; pt[a[1]] = a[3] + 0; pl[a[1]] = a[4] + 0
					}
					close(prev)
				}
				dt = t0 ? now - t0 : 0
				if (dt < 1) dt = 1
				print "ts " now > snap
			}
			{
				h = $1; rx = $2 + 0; tx = $3 + 0
				if (t0 == 0) { rr = 0; rt = 0; last = now }
				else {
					drx = rx - pr[h]; dtx = tx - pt[h]
					if (drx < 0) drx = 0
					if (dtx < 0) dtx = 0
					rr = int(drx / dt); rt = int(dtx / dt)
					last = (rx > pr[h] + 0 || tx > pt[h] + 0) ? now : (pl[h] + 0 ? pl[h] + 0 : t0)
				}
				printf "%s %d %d %d %d %d\n", h, rr, rt, rx, tx, (last > 0 ? now - last : -1)
				printf "%s %d %d %d\n", h, rx, tx, last > snap
			}
		' "$HOSTCUR" > "${HOSTCUR}.rates" 2>/dev/null

		while read -r ip rxr txt rxt xtt age; do
			[ -n "$ip" ] || continue
			json_add_object "$ip"
			json_add_int rx_rate "${rxr:-0}"
			json_add_int tx_rate "${txt:-0}"
			json_add_int rx_total "${rxt:-0}"
			json_add_int tx_total "${xtt:-0}"
			json_add_int age "${age:--1}"
			json_close_object
		done < "${HOSTCUR}.rates"
	fi

	json_close_object

	mv -f "$HOSTPREV.new" "$HOSTPREV" 2>/dev/null
	rm -f "${HOSTCUR}.rates" "$HOSTCUR"
	json_dump
	json_cleanup
}

# ---------------------------------------------------------------- topology
# Which physical and wireless links sit under the LAN bridge, at what speed,
# and which MAC learned on which port — enough to draw a branching tree.
topology() {
	local br p dev st sp dx wl mac label member parent
	br=""

	# 先认 br-lan，再认 lan 口所在的桥，最后才退到任意一个桥 —— ONU/DSA 上
	# 常有多个桥，取第一个会把整棵树挂到无关的桥上
	[ -d /sys/class/net/br-lan/brif ] && br=br-lan

	if [ -z "$br" ]; then
		for member in "$(uci -q get network.lan.device 2>/dev/null)" \
			"$(uci -q get network.lan.ifname 2>/dev/null)"; do
			[ -n "$member" ] || continue
			if [ -d "/sys/class/net/$member/brif" ]; then
				br=$member
				break
			fi
			for p in /sys/class/net/*/brif/"$member"; do
				[ -e "$p" ] || continue
				parent=$(dirname "$(dirname "$p")")
				br=${parent##*/}
				break
			done
			[ -n "$br" ] && break
		done
	fi

	if [ -z "$br" ]; then
		for p in /sys/class/net/*/brif; do
			[ -d "$p" ] || continue
			parent=$(dirname "$p")
			br=${parent##*/}
			break
		done
	fi

	json_init
	json_add_string bridge "$br"
	json_add_string wan_device "$(uci -q get network.wan.device 2>/dev/null)"
	json_add_string wan_iface "$(uci -q get network.wan.ifname 2>/dev/null)"
	json_add_string lan_device "$(uci -q get network.lan.device 2>/dev/null)"
	json_add_string lan_ifname "$(uci -q get network.lan.ifname 2>/dev/null)"

	json_add_array ports
	if [ -n "$br" ]; then
		for p in /sys/class/net/$br/brif/*; do
			[ -d "$p" ] || continue
			dev=${p##*/}
			[ -n "$dev" ] || continue
			st=$(cat "$p/operstate" 2>/dev/null)
			sp=$(cat "$p/speed" 2>/dev/null)
			dx=$(cat "$p/duplex" 2>/dev/null)
			mac=$(cat "$p/address" 2>/dev/null)
			label=""
			[ -r "$p/phys_port_name" ] && label=$(cat "$p/phys_port_name" 2>/dev/null)
			wl=0
			[ -e "$p/wireless" ] && wl=1
			[ -d "$p/ieee80211" ] && wl=1

			json_add_object
			json_add_string device "$dev"
			# 读不到 operstate 就省略，而不是塞一个 "unknown" 占满整棵树
			[ -n "$st" ] && json_add_string state "$st"
			json_add_int wireless "$wl"
			case "$sp" in ''|*[!0-9]*) ;; *) json_add_int speed "$sp" ;; esac
			[ -n "$dx" ] && json_add_string duplex "$dx"
			[ -n "$mac" ] && json_add_string mac "$mac"
			[ -n "$label" ] && json_add_string label "$label"
			json_close_object
		done
	fi
	json_close_array

	# learned MACs per port; iproute2 is present on stock images, and an
	# absent or unreadable fdb simply means "port unknown"
	json_add_array fdb
	if [ -n "$br" ] && command -v ip >/dev/null 2>&1; then
		ip -o fdb show br "$br" 2>/dev/null | awk '
			{
				mac = ""; port = ""
				for (i = 1; i <= NF; i++) {
					if ($i == "lladdr") mac = $(i + 1)
					else if ($i == "destination") port = $(i + 1)
					else if (port == "" && $i == "dev") port = $(i + 1)
				}
				if (mac == "" || port == "") next
				if (mac !~ /^[0-9a-f][0-9a-f][:]([0-9a-f][0-9a-f][:]){4,5}/) next
				if (port ~ /^br-/) next
				print mac, port
			}
		' | head -n 200 > /tmp/lucent-fdb.txt
		while read -r mac p; do
			[ -n "$mac" ] || continue
			json_add_object
			json_add_string mac "$mac"
			json_add_string port "$p"
			json_close_object
		done < /tmp/lucent-fdb.txt
		rm -f /tmp/lucent-fdb.txt
	fi
	json_close_array
	json_dump
	json_cleanup
}

# ------------------------------------------------------------- day traffic
# Today's counters are the current WAN byte totals minus a baseline captured
# on the first call of the day; a reconnect resets the kernel counters, which
# shows up as a negative delta and is clamped to zero.
DAYFILE="/tmp/lucent-day.traffic"

day_traffic() {
	local i dev brx btx today ddate="" drx=0 dtx=0 rx tx

	for i in wan wwan modem; do
		dev=$(ubus call network.interface.$i status 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null)
		[ -n "$dev" ] && break
	done
	[ -n "$dev" ] || dev=$(uci -q get network.wan.device 2>/dev/null)

	json_init

	if [ -z "$dev" ] || [ ! -r "/sys/class/net/$dev/statistics/rx_bytes" ]; then
		json_add_int ok 0
		json_dump
		json_cleanup
		return
	fi

	brx=$(cat "/sys/class/net/$dev/statistics/rx_bytes" 2>/dev/null)
	btx=$(cat "/sys/class/net/$dev/statistics/tx_bytes" 2>/dev/null)
	case "$brx" in ''|*[!0-9]*) brx=0 ;; esac
	case "$btx" in ''|*[!0-9]*) btx=0 ;; esac
	today=$(date +%Y-%m-%d 2>/dev/null)

	[ -f "$DAYFILE" ] && read -r ddate drx dtx < "$DAYFILE" 2>/dev/null

	if [ "$ddate" != "$today" ]; then
		drx=$brx; dtx=$btx
	fi

	rx=$(( brx - drx )); tx=$(( btx - dtx ))
	[ "$rx" -lt 0 ] && rx=0
	[ "$tx" -lt 0 ] && tx=0

	printf '%s %s %s\n' "$today" "$brx" "$btx" > "$DAYFILE" 2>/dev/null

	json_add_int ok 1
	json_add_string device "$dev"
	json_add_string day "$today"
	json_add_int down "$rx"
	json_add_int up "$tx"
	json_add_int since_boot_down "$brx"
	json_add_int since_boot_up "$btx"
	json_dump
	json_cleanup
}

# ------------------------------------------------------------------ updates
# All download/mirror/install logic lives in the bundled install.sh; the
# browser only ever triggers a fixed action, never supplies a URL or version.

# Cached + detached: install.sh check may take tens of seconds across mirrors,
# which would block the rpcd worker. The first call starts a background job and
# answers {"checking":1}; later calls replay the cache until it goes stale.
theme_check() {
	local now ts body ttl cur
	[ -f "$INSTALLER" ] || err "The update helper is missing"

	now=$(date +%s 2>/dev/null); case "$now" in ''|*[!0-9]*) now=0 ;; esac
	if [ -f "$CHECKCACHE" ]; then
		ts=$(sed -n '1p' "$CHECKCACHE" 2>/dev/null)
		body=$(sed -n '2p' "$CHECKCACHE" 2>/dev/null)
		case "$ts" in ''|*[!0-9]*) ts=0 ;; esac
		ttl=900
		case "$body" in *'"latest":""'*) ttl=60 ;; esac
		case "$body" in
			'{'*) [ $(( now - ts )) -ge 0 ] && [ $(( now - ts )) -lt "$ttl" ] && { printf '%s\n' "$body"; exit 0; } ;;
		esac
	fi

	if job_alive "$CHECKPID" "$CHECKJOB"; then
		cur=$(theme_current)
		json_init
		json_add_string current "$cur"
		json_add_int checking 1
		json_dump
		json_cleanup
		exit 0
	fi

	rm -f "$CHECKPID"
	cp -f "$INSTALLER" /tmp/lucent-check.sh 2>/dev/null || err "Cannot stage the installer"
	cat > "$CHECKJOB" <<EOF
#!/bin/sh
b=\$(uci -q get lucent.main.update_url)
c=\$(uci -q get lucent.main.update_cn)
[ "\$c" = 1 ] && export LUCENT_CN=1
[ -n "\$b" ] && export LUCENT_BASE_URL="\$b"
out=\$(sh /tmp/lucent-check.sh check 2>/dev/null)
rm -f /tmp/lucent-check.sh
case "\$out" in
'{'*) printf '%s\\n%s\\n' "\$(date +%s)" "\$out" >'$CHECKCACHE.tmp' && mv -f '$CHECKCACHE.tmp' '$CHECKCACHE' ;;
esac
rm -f '$CHECKPID'
EOF
	chmod 755 "$CHECKJOB"

	if command -v start-stop-daemon >/dev/null 2>&1; then
		start-stop-daemon -S -b -m -p "$CHECKPID" -x /bin/sh -- "$CHECKJOB"
	else
		setsid sh "$CHECKJOB" </dev/null >/dev/null 2>&1 &
	fi

	cur=$(theme_current)
	json_init
	json_add_string current "$cur"
	json_add_int checking 1
	json_dump
	json_cleanup
}

theme_update() {
	[ -f "$INSTALLER" ] || err "The update helper is missing"
	job_alive "$UPPID" "$UPJOB" && \
		err "An update is already running"

	rm -f "$UPCODE" "$UPLOG" "$UPPID" "$CHECKCACHE"

	# Snapshot the installer first: the package update overwrites
	# /usr/share/lucent/install.sh while the shell is still reading it.
	cp -f "$INSTALLER" /tmp/lucent-update.sh 2>/dev/null || err "Cannot stage the installer"

	# Write a self-contained job script. All paths are baked-in constants and the
	# mirror config is read fresh from uci inside the job, so nothing user-supplied
	# is ever interpolated into a shell command.
	cat > "$UPJOB" <<EOF
#!/bin/sh
b=\$(uci -q get lucent.main.update_url)
c=\$(uci -q get lucent.main.update_cn)
[ "\$c" = 1 ] && export LUCENT_CN=1
[ -n "\$b" ] && export LUCENT_BASE_URL="\$b"
sh /tmp/lucent-update.sh update >'$UPLOG' 2>&1
echo \$? >'$UPCODE'
rm -f /tmp/lucent-update.sh
rm -f '$UPPID'
EOF
	chmod 755 "$UPJOB"

	# start-stop-daemon fully daemonises (double-fork + new session) and reparents
	# to init, so rpcd's process-group cleanup on method return cannot reap it.
	if command -v start-stop-daemon >/dev/null 2>&1; then
		start-stop-daemon -S -b -m -p "$UPPID" -x /bin/sh -- "$UPJOB"
	else
		setsid sh "$UPJOB" </dev/null >/dev/null 2>&1 &
	fi

	json_init
	json_add_int ok 1
	json_add_int started 1
	json_dump
	json_cleanup
}

theme_status() {
	local pid code running=0
	pid=$(cat "$UPPID" 2>/dev/null)
	code=$(cat "$UPCODE" 2>/dev/null)
	job_alive "$UPPID" "$UPJOB" && running=1
	[ "$running" = 0 ] && rm -f "$UPPID"

	json_init
	json_add_int running "$running"
	if [ -n "$code" ]; then
		json_add_int code "$code"
	else
		json_add_int code -1
	fi
	json_add_string log "$(tail -c 1200 "$UPLOG" 2>/dev/null)"
	json_dump
	json_cleanup
}

case "$1" in
list)
	json_init
	json_add_object "media_list"; json_close_object
	json_add_object "media_commit"
		json_add_string "kind" "str"
		json_add_string "name" "str"
	json_close_object
	json_add_object "media_remove"
		json_add_string "kind" "str"
		json_add_string "name" "str"
	json_close_object
	json_add_object "wallpaper_fetch"
		json_add_string "provider" "str"
		json_add_string "query" "str"
		json_add_string "key" "str"
	json_close_object
	json_add_object "wallpaper_auto"
		json_add_string "enabled" "str"
	json_close_object
	json_add_object "plugin_check"; json_close_object
	json_add_object "plugin_install"
		json_add_string "name" "str"
	json_close_object
	json_add_object "plugin_status"; json_close_object
	json_add_object "storage"; json_close_object
	json_add_object "overview"; json_close_object
	json_add_object "topology"; json_close_object
	json_add_object "host_rates"; json_close_object
	json_add_object "day_traffic"; json_close_object
	json_add_object "pkg_updates"; json_close_object
	json_add_object "theme_check"; json_close_object
	json_add_object "theme_update"; json_close_object
	json_add_object "theme_status"; json_close_object
	json_dump
	json_cleanup
	;;
call)
	case "$2" in
		media_list) media_list ;;
		media_commit) media_commit ;;
		media_remove) media_remove ;;
		wallpaper_fetch) wallpaper_fetch ;;
		wallpaper_auto) wallpaper_auto ;;
		plugin_check) plugin_check ;;
		plugin_install) plugin_install ;;
		plugin_status) plugin_status ;;
		storage) storage ;;
		overview) overview ;;
		topology) topology ;;
		host_rates) host_rates ;;
		day_traffic) day_traffic ;;
		pkg_updates) pkg_updates ;;
		theme_check) theme_check ;;
		theme_update) theme_update ;;
		theme_status) theme_status ;;
		*) err "Unknown method" ;;
	esac
	;;
*)
	err "Unsupported request"
	;;
esac
