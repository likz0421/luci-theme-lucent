#!/bin/sh
# Lucent 3 helper: media library, online wallpapers and allow-listed packages.
# The browser never supplies a shell command or an arbitrary path.

. /usr/share/libubox/jshn.sh

ROOT="/www/luci-static/lucent/media"
URL="/luci-static/lucent/media"
TMPDIR="/tmp/lucent-upload"
TMP="$TMPDIR/file.bin"
RUN="/var/run"
LOG="$RUN/lucent-install.log"
CODE="$RUN/lucent-install.code"
PID="$RUN/lucent-install.pid"
IJOB="$RUN/lucent-install.job.sh"
UPLOG="$RUN/lucent-update.log"
UPCODE="$RUN/lucent-update.code"
UPPID="$RUN/lucent-update.pid"
UPJOB="$RUN/lucent-update.job.sh"
CHECKCACHE="/tmp/lucent-check.json"
CHECKPID="$RUN/lucent-check.pid"
CHECKJOB="$RUN/lucent-check.job.sh"
INSTALLER="/usr/share/lucent/install.sh"

mkdir -p "$TMPDIR" 2>/dev/null || true

err() {
	json_init
	json_add_int ok 0
	json_add_string error "$1"
	json_dump
	json_cleanup
	exit 0
}

ok() {
	json_init
	json_add_int ok 1
	json_dump
	json_cleanup
	exit 0
}

magic() {
	local hex
	if command -v hexdump >/dev/null 2>&1; then
		hex=$(hexdump -v -n 12 -e '1/1 "%02x"' "$1" 2>/dev/null)
	elif command -v od >/dev/null 2>&1; then
		hex=$(od -An -tx1 -N12 "$1" 2>/dev/null | tr -d ' \n')
	else
		return 1
	fi
	case "$hex" in
		ffd8ff*) echo jpg ;;
		89504e470d0a1a0a*) echo png ;;
		47494638*) echo gif ;;
		52494646????????57454250) echo webp ;;
		00000100*) echo ico ;;
		????????66747970) echo mp4 ;;
		????????66747970*) echo mp4 ;;
		1a45dfa3*) echo webm ;;
	esac
}

download() {
	local url="$1" out="$2"
	rm -f "$out"
	if command -v uclient-fetch >/dev/null 2>&1; then
		uclient-fetch -q -T 30 -O "$out" "$url" >/dev/null 2>&1
	elif command -v wget >/dev/null 2>&1; then
		wget -q -T 30 -O "$out" "$url" >/dev/null 2>&1
	else
		return 1
	fi
	[ -s "$out" ]
}

safe_name() {
	printf '%s' "$1" | sed 's/\.[^.]*$//; s/[^A-Za-z0-9._-]/-/g; s/^-*//; s/-*$//' | cut -c1-48
}

media_url() {
	echo "$URL/$1/$2"
}

# ------------------------------------------------------------------ methods
media_list() {
	local kind f name size
	json_init
	json_add_array "items"
	for kind in image video icon wallpaper; do
		[ -d "$ROOT/$kind" ] || continue
		for f in "$ROOT/$kind"/*; do
			[ -f "$f" ] && [ ! -L "$f" ] || continue
			name=${f##*/}
			case "$name" in .*) continue ;; esac
			size=$(wc -c < "$f" 2>/dev/null)
			json_add_object
			json_add_string kind "$kind"
			json_add_string name "$name"
			json_add_string url "$(media_url "$kind" "$name")"
			json_add_int size "${size:-0}"
			json_close_object
		done
	done
	json_close_array
	json_dump
	json_cleanup
}

media_commit() {
	local kind name size max ext base out n
	read -r input
	json_load "$input"
	json_get_var kind kind
	json_get_var name name
	json_cleanup

	case "$kind" in image|video|icon) ;; *) err "Unknown media type" ;; esac
	[ -f "$TMP" ] && [ ! -L "$TMP" ] || err "Upload not found"

	size=$(wc -c < "$TMP" 2>/dev/null)
	size=${size:-0}
	[ "$size" -gt 0 ] || err "The file is empty"

	case "$kind" in
		image) max=8388608 ;;
		video) max=33554432 ;;
		icon) max=1048576 ;;
	esac
	[ "$size" -le "$max" ] || err "The file is larger than the limit"

	ext=$(magic "$TMP")
	[ -n "$ext" ] || err "Unsupported file format"
	case "$kind:$ext" in
		image:jpg|image:png|image:gif|image:webp|video:mp4|video:webm|icon:png|icon:webp|icon:ico) ;;
		*) err "This format is not allowed for this type" ;;
	esac

	base=$(safe_name "$name")
	[ -n "$base" ] || base="$kind"
	mkdir -p "$ROOT/$kind" || err "Cannot create the media directory"
	chmod 755 "$ROOT" "$ROOT/$kind" 2>/dev/null
	out="$ROOT/$kind/${base}-$(date +%s).$ext"
	n=1
	while [ -e "$out" ]; do
		out="$ROOT/$kind/${base}-$(date +%s)-$n.$ext"
		n=$((n + 1))
	done

	mv -f "$TMP" "$out" || err "Cannot save the upload"
	chmod 644 "$out" 2>/dev/null
	chown root:root "$out" 2>/dev/null

	json_init
	json_add_int ok 1
	json_add_string kind "$kind"
	json_add_string name "${out##*/}"
	json_add_string url "$(media_url "$kind" "${out##*/}")"
	json_add_int size "$size"
	json_dump
	json_cleanup
}

media_remove() {
	local kind name f
	read -r input
	json_load "$input"
	json_get_var kind kind
	json_get_var name name
	json_cleanup

	case "$kind" in image|video|icon|wallpaper) ;; *) err "Unknown media type" ;; esac
	case "$name" in ''|.*|*/*|*\\*) err "Invalid file name" ;; esac
	f="$ROOT/$kind/$name"
	[ -f "$f" ] && [ ! -L "$f" ] || err "File not found"
	rm -f "$f" || err "Cannot remove the file"
	ok
}

wallpaper_fetch() {
	local provider query key tmp url file ext base out n
	read -r input
	json_load "$input"
	json_get_var provider provider
	json_get_var query query
	json_get_var key key
	json_cleanup

	case "$provider" in bing|unsplash|wallhaven) ;; *) err "Unknown wallpaper source" ;; esac
	case "$key" in *[!A-Za-z0-9_-]*) err "Invalid API key" ;; esac
	query=$(printf '%s' "$query" | tr -cd 'A-Za-z0-9 _-' | cut -c1-60)
	query=$(printf '%s' "$query" | sed 's/ /%20/g')

	tmp="/tmp/lucent-wallpaper.json"
	case "$provider" in
		bing)
			url="https://www.bing.com/HPImageArchive.aspx?format=js&idx=0&n=1&mkt=zh-CN"
			download "$url" "$tmp" || err "Cannot reach Bing"
			url=$(jsonfilter -i "$tmp" -e '@.images[0].url' 2>/dev/null)
			[ -n "$url" ] || err "Bing returned no image"
			case "$url" in http*) ;; *) url="https://www.bing.com$url" ;; esac
			;;
		unsplash)
			[ -n "$key" ] || err "Unsplash needs an API key"
			url="https://api.unsplash.com/photos/random?orientation=landscape&client_id=$key"
			[ -n "$query" ] && url="$url&query=$query"
			download "$url" "$tmp" || err "Cannot reach Unsplash"
			url=$(jsonfilter -i "$tmp" -e '@.urls.full' 2>/dev/null)
			[ -n "$url" ] || err "Unsplash returned no image"
			;;
		wallhaven)
			url="https://wallhaven.cc/api/v1/search?sorting=random&atleast=1920x1080&categories=111&purity=100"
			[ -n "$query" ] && url="$url&q=$query"
			download "$url" "$tmp" || err "Cannot reach Wallhaven"
			url=$(jsonfilter -i "$tmp" -e '@.data[0].path' 2>/dev/null)
			[ -n "$url" ] || err "Wallhaven returned no image"
			;;
	esac

	file="/tmp/lucent-wallpaper.img"
	download "$url" "$file" || err "Cannot download the image"
	ext=$(magic "$file")
	case "$ext" in jpg|png|webp) ;; *) rm -f "$file"; err "The source did not return an image" ;; esac

	mkdir -p "$ROOT/wallpaper" || err "Cannot create the wallpaper directory"
	chmod 755 "$ROOT" "$ROOT/wallpaper" 2>/dev/null
	base=$(safe_name "$provider")
	out="$ROOT/wallpaper/${base}-$(date +%s).$ext"
	n=1
	while [ -e "$out" ]; do
		out="$ROOT/wallpaper/${base}-$(date +%s)-$n.$ext"
		n=$((n + 1))
	done
	mv -f "$file" "$out" || err "Cannot save the wallpaper"
	chmod 644 "$out" 2>/dev/null

	json_init
	json_add_int ok 1
	json_add_string name "${out##*/}"
	json_add_string url "$(media_url wallpaper "${out##*/}")"
	json_dump
	json_cleanup
}

plugin_installed() {
	local pkg="$1"
	if command -v apk >/dev/null 2>&1; then
		apk info -e "$pkg" >/dev/null 2>&1
	elif command -v opkg >/dev/null 2>&1; then
		opkg list-installed 2>/dev/null | grep -q "^$pkg "
	else
		return 1
	fi
}

plugin_check() {
	local name pkg
	json_init
	json_add_array "items"
	for name in openclash passwall passwall2 ssrplus mosdns adguardhome dockerman smartdns; do
		case "$name" in
			openclash) pkg="luci-app-openclash" ;;
			passwall) pkg="luci-app-passwall" ;;
			passwall2) pkg="luci-app-passwall2" ;;
			ssrplus) pkg="luci-app-ssr-plus" ;;
			mosdns) pkg="luci-app-mosdns" ;;
			adguardhome) pkg="luci-app-adguardhome" ;;
			dockerman) pkg="luci-app-dockerman" ;;
			smartdns) pkg="luci-app-smartdns" ;;
		esac
		json_add_object
		json_add_string name "$name"
		json_add_string pkg "$pkg"
		json_add_int installed "$(plugin_installed "$pkg" && echo 1 || echo 0)"
		json_close_object
	done
	json_close_array
	json_dump
	json_cleanup
}

plugin_install() {
	local name pkg job
	read -r input
	json_load "$input"
	json_get_var name name
	json_cleanup

	case "$name" in
		openclash) pkg="luci-app-openclash" ;;
		passwall) pkg="luci-app-passwall" ;;
		passwall2) pkg="luci-app-passwall2" ;;
		ssrplus) pkg="luci-app-ssr-plus" ;;
		mosdns) pkg="luci-app-mosdns" ;;
		adguardhome) pkg="luci-app-adguardhome" ;;
		dockerman) pkg="luci-app-dockerman" ;;
		smartdns) pkg="luci-app-smartdns" ;;
		*) err "This package is not allow-listed" ;;
	esac

	if plugin_installed "$pkg"; then
		json_init
		json_add_int ok 1
		json_add_int installed 1
		json_add_string message "Already installed"
		json_dump
		json_cleanup
		exit 0
	fi

	[ -f "$PID" ] && kill -0 "$(cat "$PID" 2>/dev/null)" 2>/dev/null && \
		err "Another installation is still running"

	rm -f "$CODE" "$LOG" "$PID"
	if command -v apk >/dev/null 2>&1; then
		cat > "$IJOB" <<EOF
#!/bin/sh
apk add '$pkg' >'$LOG' 2>&1
echo \$? >'$CODE'
EOF
	else
		cat > "$IJOB" <<EOF
#!/bin/sh
opkg update >'$LOG' 2>&1
opkg install '$pkg' >>'$LOG' 2>&1
echo \$? >'$CODE'
EOF
	fi
	chmod 755 "$IJOB"

	if command -v start-stop-daemon >/dev/null 2>&1; then
		start-stop-daemon -S -b -m -p "$PID" -x /bin/sh -- "$IJOB"
	else
		setsid sh "$IJOB" </dev/null >/dev/null 2>&1 &
	fi

	json_init
	json_add_int ok 1
	json_add_int started 1
	json_add_string pkg "$pkg"
	json_dump
	json_cleanup
}

plugin_status() {
	local pid code running=0
	pid=$(cat "$PID" 2>/dev/null)
	code=$(cat "$CODE" 2>/dev/null)
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && running=1
	[ "$running" = 0 ] && rm -f "$PID"

	json_init
	json_add_int running "$running"
	if [ -n "$code" ]; then
		json_add_int code "$code"
	else
		json_add_int code -1
	fi
	json_add_string log "$(tail -c 1200 "$LOG" 2>/dev/null)"
	json_dump
	json_cleanup
}

wallpaper_auto() {
	local enabled mark line
	read -r input
	json_load "$input"
	json_get_var enabled enabled
	json_cleanup

	case "$enabled" in
		1)
			mkdir -p /etc/crontabs
			mark="# lucent-wallpaper"
			line="0 6 * * * /bin/sh /usr/share/lucent/wallpaper.sh $mark"
			grep -qF "$mark" /etc/crontabs/root 2>/dev/null || printf '%s\n' "$line" >> /etc/crontabs/root
			chmod 600 /etc/crontabs/root 2>/dev/null
			uci -q set lucent.main.wallpaper_auto=1
			;;
		0)
			sed -i "/# lucent-wallpaper/d" /etc/crontabs/root 2>/dev/null
			uci -q set lucent.main.wallpaper_auto=0
			;;
		*) err "Invalid argument" ;;
	esac
	uci -q commit lucent
	/etc/init.d/cron restart >/dev/null 2>&1 || true
	ok
}

# Count upgradable system packages, cached and detached like theme_check.
PKGUPCACHE="/tmp/lucent-pkgupdates.json"
PKGUPPID="$RUN/lucent-pkgupdates.pid"
PKGUPJOB="$RUN/lucent-pkgupdates.job.sh"

pkg_updates() {
	local now ts body
	now=$(date +%s 2>/dev/null); case "$now" in ''|*[!0-9]*) now=0 ;; esac
	if [ -f "$PKGUPCACHE" ]; then
		ts=$(sed -n '1p' "$PKGUPCACHE" 2>/dev/null)
		body=$(sed -n '2p' "$PKGUPCACHE" 2>/dev/null)
		case "$ts" in ''|*[!0-9]*) ts=0 ;; esac
		case "$body" in
			'{'*) [ $(( now - ts )) -lt 3600 ] && { printf '%s\n' "$body"; exit 0; } ;;
		esac
	fi

	if [ -f "$PKGUPPID" ] && kill -0 "$(cat "$PKGUPPID" 2>/dev/null)" 2>/dev/null; then
		json_init
		json_add_int checking 1
		json_dump
		json_cleanup
		exit 0
	fi

	rm -f "$PKGUPPID"
	cat > "$PKGUPJOB" <<EOF
#!/bin/sh
if command -v apk >/dev/null 2>&1; then
	apk update >/dev/null 2>&1
	n=\$(apk list --upgradable 2>/dev/null | grep -c '^')
else
	opkg update >/dev/null 2>&1
	n=\$(opkg list-upgradable 2>/dev/null | grep -c ' - ')
fi
case "\$n" in ''|*[!0-9]*) n=-1 ;; esac
{ printf '%s\\n' "\$(date +%s)"; printf '{"count":%d}\\n' "\$n"; } >'$PKGUPCACHE.tmp' && mv -f '$PKGUPCACHE.tmp' '$PKGUPCACHE'
EOF
	chmod 755 "$PKGUPJOB"

	if command -v start-stop-daemon >/dev/null 2>&1; then
		start-stop-daemon -S -b -m -p "$PKGUPPID" -x /bin/sh -- "$PKGUPJOB"
	else
		setsid sh "$PKGUPJOB" </dev/null >/dev/null 2>&1 &
	fi

	json_init
	json_add_int checking 1
	json_dump
	json_cleanup
}

storage() {
	local mp size avail
	json_init
	for mp in / /overlay; do
		size=$(df -kP "$mp" 2>/dev/null | awk 'NR==2{print $2}')
		avail=$(df -kP "$mp" 2>/dev/null | awk 'NR==2{print $4}')
		[ -n "$size" ] || continue
		json_add_object "$mp"
		json_add_int total "$(( size * 1024 ))"
		json_add_int free "$(( avail * 1024 ))"
		json_close_object
	done
	json_dump
	json_cleanup
}

theme_current() {
	local v=""
	if command -v apk >/dev/null 2>&1; then
		v=$(apk info -e -v luci-theme-lucent 2>/dev/null | head -n1 | sed 's/^luci-theme-lucent-//')
	elif command -v opkg >/dev/null 2>&1; then
		v=$(opkg status luci-theme-lucent 2>/dev/null | sed -n 's/^Version: //p' | head -n1)
	fi
	[ -n "$v" ] || v=$(cat /usr/share/lucent/version 2>/dev/null)
	printf '%s' "$v"
}

# ------------------------------------------------------------------ overview
overview() {
	local ver cores l1 l5 l15 pids running total ct ctmax v best f
	ver=$(theme_current)
	cores=$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)
	case "$cores" in ''|*[!0-9]*) cores=0 ;; esac
	pids=""
	[ -r /proc/loadavg ] && read -r l1 l5 l15 pids _x < /proc/loadavg
	running=""; total=""
	case "$pids" in
		*/*) running="${pids%%/*}"; total="${pids##*/}" ;;
	esac
	ct=$(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null)
	ctmax=$(cat /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null)

	best=""
	for f in /sys/class/thermal/thermal_zone*/temp; do
		[ -f "$f" ] || continue
		v=$(cat "$f" 2>/dev/null)
		case "$v" in ''|*[!0-9]*) continue ;; esac
		# Some SoCs report millidegrees here (46000), others degrees (46).
		[ "$v" -ge 1000 ] && v=$((v / 1000))
		[ "$v" -gt 0 ] && [ "$v" -lt 120 ] || continue
		{ [ -z "$best" ] || [ "$v" -lt "$best" ]; } && best=$v
	done
	if [ -z "$best" ]; then
		for f in /sys/class/hwmon/hwmon*/temp*_input; do
			[ -f "$f" ] || continue
			v=$(cat "$f" 2>/dev/null)
			case "$v" in ''|*[!0-9]*) continue ;; esac
			[ "$v" -ge 1000 ] && [ "$v" -le 120000 ] || continue
			v=$((v / 1000))
			{ [ -z "$best" ] || [ "$v" -lt "$best" ]; } && best=$v
		done
	fi

	json_init
	json_add_string version "$ver"
	json_add_int cores "$cores"
	[ -n "$l1" ] && json_add_string load1 "$l1"
	[ -n "$l5" ] && json_add_string load5 "$l5"
	[ -n "$l15" ] && json_add_string load15 "$l15"
	[ -n "$running" ] && json_add_int processes_running "$running"
	[ -n "$total" ] && json_add_int processes_total "$total"
	[ -n "$ct" ] && json_add_int conntrack "$ct"
	[ -n "$ctmax" ] && json_add_int conntrack_max "$ctmax"
	[ -n "$best" ] && json_add_int temp_c "$best"
	json_dump
	json_cleanup
}

# ------------------------------------------------------------------ updates
# All download/mirror/install logic lives in the bundled install.sh; the
# browser only ever triggers a fixed action, never supplies a URL or version.

# Cached + detached: install.sh check may take tens of seconds across mirrors,
# which would block the rpcd worker. The first call starts a background job and
# answers {"checking":1}; later calls replay the cache until it goes stale.
theme_check() {
	local now ts body ttl cur
	[ -f "$INSTALLER" ] || err "The update helper is missing"

	now=$(date +%s 2>/dev/null); case "$now" in ''|*[!0-9]*) now=0 ;; esac
	if [ -f "$CHECKCACHE" ]; then
		ts=$(sed -n '1p' "$CHECKCACHE" 2>/dev/null)
		body=$(sed -n '2p' "$CHECKCACHE" 2>/dev/null)
		case "$ts" in ''|*[!0-9]*) ts=0 ;; esac
		ttl=900
		case "$body" in *'"latest":""'*) ttl=60 ;; esac
		case "$body" in
			'{'*) [ $(( now - ts )) -lt "$ttl" ] && { printf '%s\n' "$body"; exit 0; } ;;
		esac
	fi

	if [ -f "$CHECKPID" ] && kill -0 "$(cat "$CHECKPID" 2>/dev/null)" 2>/dev/null; then
		cur=$(theme_current)
		json_init
		json_add_string current "$cur"
		json_add_int checking 1
		json_dump
		json_cleanup
		exit 0
	fi

	rm -f "$CHECKPID"
	cp -f "$INSTALLER" /tmp/lucent-check.sh 2>/dev/null || err "Cannot stage the installer"
	cat > "$CHECKJOB" <<EOF
#!/bin/sh
b=\$(uci -q get lucent.main.update_url)
c=\$(uci -q get lucent.main.update_cn)
[ "\$c" = 1 ] && export LUCENT_CN=1
[ -n "\$b" ] && export LUCENT_BASE_URL="\$b"
out=\$(sh /tmp/lucent-check.sh check 2>/dev/null)
rm -f /tmp/lucent-check.sh
case "\$out" in
'{'*) printf '%s\\n%s\\n' "\$(date +%s)" "\$out" >'$CHECKCACHE.tmp' && mv -f '$CHECKCACHE.tmp' '$CHECKCACHE' ;;
esac
EOF
	chmod 755 "$CHECKJOB"

	if command -v start-stop-daemon >/dev/null 2>&1; then
		start-stop-daemon -S -b -m -p "$CHECKPID" -x /bin/sh -- "$CHECKJOB"
	else
		setsid sh "$CHECKJOB" </dev/null >/dev/null 2>&1 &
	fi

	cur=$(theme_current)
	json_init
	json_add_string current "$cur"
	json_add_int checking 1
	json_dump
	json_cleanup
}

theme_update() {
	[ -f "$INSTALLER" ] || err "The update helper is missing"
	[ -f "$UPPID" ] && kill -0 "$(cat "$UPPID" 2>/dev/null)" 2>/dev/null && \
		err "An update is already running"

	rm -f "$UPCODE" "$UPLOG" "$UPPID" "$CHECKCACHE"

	# Snapshot the installer first: the package update overwrites
	# /usr/share/lucent/install.sh while the shell is still reading it.
	cp -f "$INSTALLER" /tmp/lucent-update.sh 2>/dev/null || err "Cannot stage the installer"

	# Write a self-contained job script. All paths are baked-in constants and the
	# mirror config is read fresh from uci inside the job, so nothing user-supplied
	# is ever interpolated into a shell command.
	cat > "$UPJOB" <<EOF
#!/bin/sh
b=\$(uci -q get lucent.main.update_url)
c=\$(uci -q get lucent.main.update_cn)
[ "\$c" = 1 ] && export LUCENT_CN=1
[ -n "\$b" ] && export LUCENT_BASE_URL="\$b"
sh /tmp/lucent-update.sh update >'$UPLOG' 2>&1
echo \$? >'$UPCODE'
rm -f /tmp/lucent-update.sh
EOF
	chmod 755 "$UPJOB"

	# start-stop-daemon fully daemonises (double-fork + new session) and reparents
	# to init, so rpcd's process-group cleanup on method return cannot reap it.
	if command -v start-stop-daemon >/dev/null 2>&1; then
		start-stop-daemon -S -b -m -p "$UPPID" -x /bin/sh -- "$UPJOB"
	else
		setsid sh "$UPJOB" </dev/null >/dev/null 2>&1 &
	fi

	json_init
	json_add_int ok 1
	json_add_int started 1
	json_dump
	json_cleanup
}

theme_status() {
	local pid code running=0
	pid=$(cat "$UPPID" 2>/dev/null)
	code=$(cat "$UPCODE" 2>/dev/null)
	[ -n "$pid" ] && kill -0 "$pid" 2>/dev/null && running=1
	[ "$running" = 0 ] && rm -f "$UPPID"

	json_init
	json_add_int running "$running"
	if [ -n "$code" ]; then
		json_add_int code "$code"
	else
		json_add_int code -1
	fi
	json_add_string log "$(tail -c 1200 "$UPLOG" 2>/dev/null)"
	json_dump
	json_cleanup
}

case "$1" in
list)
	json_init
	json_add_object "media_list"; json_close_object
	json_add_object "media_commit"
		json_add_string "kind" "str"
		json_add_string "name" "str"
	json_close_object
	json_add_object "media_remove"
		json_add_string "kind" "str"
		json_add_string "name" "str"
	json_close_object
	json_add_object "wallpaper_fetch"
		json_add_string "provider" "str"
		json_add_string "query" "str"
		json_add_string "key" "str"
	json_close_object
	json_add_object "wallpaper_auto"
		json_add_string "enabled" "str"
	json_close_object
	json_add_object "plugin_check"; json_close_object
	json_add_object "plugin_install"
		json_add_string "name" "str"
	json_close_object
	json_add_object "plugin_status"; json_close_object
	json_add_object "storage"; json_close_object
	json_add_object "overview"; json_close_object
	json_add_object "pkg_updates"; json_close_object
	json_add_object "theme_check"; json_close_object
	json_add_object "theme_update"; json_close_object
	json_add_object "theme_status"; json_close_object
	json_dump
	json_cleanup
	;;
call)
	case "$2" in
		media_list) media_list ;;
		media_commit) media_commit ;;
		media_remove) media_remove ;;
		wallpaper_fetch) wallpaper_fetch ;;
		wallpaper_auto) wallpaper_auto ;;
		plugin_check) plugin_check ;;
		plugin_install) plugin_install ;;
		plugin_status) plugin_status ;;
		storage) storage ;;
		overview) overview ;;
		pkg_updates) pkg_updates ;;
		theme_check) theme_check ;;
		theme_update) theme_update ;;
		theme_status) theme_status ;;
		*) err "Unknown method" ;;
	esac
	;;
*)
	err "Unsupported request"
	;;
esac
