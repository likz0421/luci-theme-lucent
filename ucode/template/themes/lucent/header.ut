-#}

{%
	import { getuid, getspnam } from 'luci.core';

	const binfo = ubus.call('system', 'board');
	const board = (type(binfo) == 'object') ? binfo : {};
	const uci = ubus.call('uci', 'get', { config: 'lucent' });
	const cfg = (type(uci) == 'object' && type(uci.values) == 'object' &&
	             type(uci.values.main) == 'object') ? uci.values.main : {};

	const palette = cfg.palette ?? 'mist';
	const mode = cfg.mode ?? 'auto';
	const glass = cfg.glass ?? '1';
	const blur = cfg.glass_blur ?? '20';
	const alpha = cfg.glass_alpha ?? '62';
	const dim = cfg.bg_dim ?? '0';
	const density = cfg.density ?? 'cozy';
	const greeting = cfg.greeting ?? '1';
	const show_trend = cfg.show_trend ?? '1';
	const show_topo = cfg.show_topo ?? '1';
	const show_updates = cfg.show_updates ?? '1';
	const logo = cfg.logo_image ?? '';
	const vraw = ubus.call('file', 'read', { path: '/usr/share/lucent/version' });
	let lver = (type(vraw) == 'object' && type(vraw.content) == 'array') ? trim('' + vraw.content[0]) : '';
	/* When the version marker is missing (old file-copy installs), fall back
	   to the stylesheet mtime so the cache buster still changes per upgrade. */
	if (lver == '') {
		try {
			const fsmod = require('fs');
			const st = fsmod.stat('/www' + (media ?? '/luci-static/lucent') + '/theme.css');
			if (st && st.mtime != null)
				lver = 'm' + st.mtime;
		} catch (e) {}
	}
	if (lver == '')
		lver = 'l' + (version?.luciversion ?? '0');
	const bg = cfg.background ?? '';
	const lbg = lc(bg);

	const video = (index(lbg, '.mp4') >= 0 || index(lbg, '.webm') >= 0 || index(lbg, '.ogv') >= 0);

	http.prepare_content('text/html; charset=UTF-8');
-%}

<!DOCTYPE html>
<html lang="{{ dispatcher.lang }}"
      data-palette="{{ entityencode(palette, true) }}"
      data-mode="{{ entityencode(mode, true) }}"
      data-glass="{{ entityencode(glass, true) }}"
      data-density="{{ entityencode(density, true) }}"
      data-blur="{{ entityencode(blur, true) }}"
      data-alpha="{{ entityencode(alpha, true) }}"
      data-dim="{{ entityencode(dim, true) }}"
      data-greeting="{{ entityencode(greeting, true) }}"
      data-trend="{{ entityencode(show_trend, true) }}"
      data-topo="{{ entityencode(show_topo, true) }}"
      data-updates="{{ entityencode(show_updates, true) }}"
      style="--glass-blur:{{ entityencode(blur, true) }}px;--glass-alpha:{{ entityencode(alpha, true) }}%;--bg-dim:{{ entityencode(dim, true) }}">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
	<meta name="darkreader-lock">
	<title>{{ striptags(`${board.hostname ?? '?'}${dispatched?.title ? ` | ${_(dispatched.title)}` : ''}`) }}</title>
	<script>
		(function () {
			var root = document.documentElement;
			var mode = root.dataset.mode || 'auto';
			var dark = mode === 'dark' || (mode === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
			root.dataset.theme = dark ? 'dark' : 'light';
			try {
				var w = innerWidth;
				var rail = localStorage.getItem('lucent.rail');
				if (w >= 981 && (rail === '1' || (!rail && w < 1200)))
					root.dataset.rail = '1';
			} catch (e) {}
		})();
	</script>
	<link rel="stylesheet" href="{{ media }}/theme.css?v={{ lver != '' ? lver : '3' }}">
	<link rel="icon" href="{{ media }}/logo.svg" sizes="any">
	{% if (node?.css): %}
	<link rel="stylesheet" href="{{ resource }}/{{ node.css }}">
	{% endif %}
	{% if (css): %}
	<style>{{ css }}</style>
	{% endif %}
	<script src="{{ dispatcher.build_url('admin/translations', dispatcher.lang) }}"></script>
	<script src="{{ resource }}/cbi.js?v=26.288.56989~75a306d"></script>
</head>

<body class="ltc-page lang_{{ dispatcher.lang }}" data-page="{{ entityencode(join('-', ctx.request_path), true) }}">
	{% if (bg): %}
		{% if (video): %}
		<video class="ltc-wall" src="{{ entityencode(bg, true) }}" autoplay muted loop playsinline></video>
		{% else %}
		<div class="ltc-wall" style="background-image:url('{{ entityencode(bg, true) }}')"></div>
		{% endif %}
	{% endif %}

	{% if (!blank_page): %}
	<div class="ltc-shell">
		<aside class="ltc-side" id="ltc-side">
			<a class="ltc-brand" href="{{ dispatcher.build_url('admin/home') }}">
				{% if (logo): %}
				<img class="ltc-brand-img" src="{{ entityencode(logo, true) }}" alt="" onerror="if (this.dataset.fb) { this.remove(); } else { this.dataset.fb = '1'; this.src = '{{ entityencode(media, true) }}/logo.svg'; }">
				{% else %}
				<span class="ltc-mark" aria-hidden="true">
					<svg viewBox="0 0 40 40"><rect width="40" height="40" rx="13"/><path d="M11 25a9 9 0 0 1 18 0M15.4 25a4.6 4.6 0 0 1 9.2 0"/><circle cx="20" cy="28.2" r="1.9"/></svg>
				</span>
				{% endif %}
				<span class="ltc-brand-t">
					<b>Lucent</b>
					<small>{{ striptags(board.hostname ?? '') }}</small>
				</span>
			</a>

			<nav class="ltc-nav" aria-label="{{ _('Navigation') }}">
				<ul id="topmenu"></ul>
			</nav>

			<div class="ltc-side-foot">
				<ul id="modemenu" class="ltc-modes"></ul>
				<button type="button" class="ltc-icon-btn" data-ltc-theme title="{{ _('Toggle appearance') }}">
					<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 1 0 16z"/></svg>
				</button>
			</div>
		</aside>

		<div class="ltc-stage">
			<header class="ltc-bar">
				<button type="button" class="ltc-icon-btn ltc-burger" data-ltc-menu aria-label="{{ _('Menu') }}">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
				</button>
				<div class="ltc-crumb">
					<span>{{ _('OpenWrt') }}</span>
					<b>{{ _(dispatched?.title ?? '') }}</b>
				</div>
				<div class="ltc-bar-right">
					<button type="button" class="ltc-icon-btn ltc-search-btn" data-ltc-search aria-label="{{ _('Search') }}" title="{{ _('Search') }} · Ctrl K">
						<svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/></svg>
					</button>
					<div id="indicators"></div>
				</div>
			</header>

			<main id="maincontent" class="ltc-content">
				{% if (getuid() == 0 && getspnam('root')?.pwdp === ''): %}
				<div class="ltc-alert bad">
					<b>{{ _('No password set!') }}</b>
					<p>{{ _('There is no password set on this router. Please configure a root password to protect the web interface.') }}</p>
					<a class="ltc-btn" href="{{ dispatcher.build_url('admin/system/admin') }}">{{ _('Set password') }}</a>
				</div>
				{% endif %}

				{% if (board.rootfs_type == 'initramfs'): %}
				<div class="ltc-alert warn">
					<b>{{ _('Recovery mode') }}</b>
					<p>{{ _('No changes to settings will be stored and are lost after rebooting.') }}</p>
				</div>
				{% endif %}

				<noscript>
					<div class="ltc-alert bad">
						<b>{{ _('JavaScript required!') }}</b>
						<p>{{ _('You must enable JavaScript in your browser or LuCI will not work properly.') }}</p>
					</div>
				</noscript>

				<div id="tabmenu" class="ltc-tabmenu"></div>
	{% endif %}
