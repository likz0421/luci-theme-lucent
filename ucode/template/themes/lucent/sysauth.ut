{% include('header', { blank_page: true }) %}

<div class="ltc-login">
	<div class="ltc-login-card">
		<div class="ltc-login-mark" aria-hidden="true">
			<svg viewBox="0 0 40 40"><rect width="40" height="40" rx="13"/><path d="M11 25a9 9 0 0 1 18 0M15.4 25a4.6 4.6 0 0 1 9.2 0"/><circle cx="20" cy="28.2" r="1.9"/></svg>
		</div>
		<h1>{{ _('Welcome back') }}</h1>
		<p class="ltc-login-sub">{{ _('Sign in to manage this router.') }}</p>

		{% if (fuser): %}
		<div class="ltc-login-err" role="alert">{{ _('Invalid username and/or password.') }}</div>
		{% endif %}

		<form method="post" class="ltc-login-form" id="ltc-login-form">
			<label class="ltc-field">
				<span>{{ _('Username') }}</span>
				<input name="luci_username" id="luci_username" type="text" autocomplete="username"
				       value="{{ entityencode(duser, true) }}" spellcheck="false" autocapitalize="none">
			</label>
			<label class="ltc-field">
				<span>{{ _('Password') }}</span>
				<input name="luci_password" id="luci_password" type="password" autocomplete="current-password">
				<button type="button" class="ltc-eye" data-ltc-eye aria-label="{{ _('Show password') }}">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12S6 5.8 12 5.8 21.5 12 21.5 12 18 18.2 12 18.2 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="3"/></svg>
				</button>
			</label>
			<button type="submit" class="ltc-btn primary block">{{ _('Log in') }}</button>
		</form>

		<p class="ltc-login-note">{{ _('Protected by your router password.') }}</p>
	</div>
</div>

{% include('footer', { blank_page: true }) %}
